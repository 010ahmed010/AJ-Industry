{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "build": "npm run build:client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "npm run build --workspace=@workspace/aj-industry",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "esbuild": "0.27.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
