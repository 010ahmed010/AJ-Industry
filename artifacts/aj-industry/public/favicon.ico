<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0E1E38"/>
      <stop offset="100%" stop-color="#050B18"/>
    </linearGradient>
    <linearGradient id="primaryGrad" x1="12" y1="18" x2="38" y2="46" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#56ABFF"/>
      <stop offset="100%" stop-color="#2B85E8"/>
    </linearGradient>
    <linearGradient id="whiteGrad" x1="34" y1="18" x2="51" y2="46" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#D6E4F8"/>
    </linearGradient>
  </defs>

  <!-- Background Base Badge -->
  <rect width="64" height="64" rx="14" fill="url(#bg)"/>

  <!-- Outer Precision Neon/Primary Border -->
  <rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="#3D9BFF" stroke-width="2.2" stroke-opacity="0.9"/>

  <!-- Technical Blueprint Corner Notches -->
  <path d="M7 14V7h7M50 7h7v7M57 50v7h-7M14 57H7v-7" fill="none" stroke="#3D9BFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.6"/>

  <!-- AJ Monogram (Industrial Precision Vector Geometry) -->
  <g>
    <!-- Letter 'A' in signature electric blue -->
    <path d="M12 46 L21.5 18 H28.5 L38 46 H31.2 L29.3 40.2 H20.7 L18.8 46 Z M22.3 35 H27.7 L25 26.2 Z" fill="url(#primaryGrad)"/>

    <!-- Letter 'J' in high-contrast crisp titanium white -->
    <path d="M40 18 H50.5 V38.5 C50.5 43.5 47 46.5 41.5 46.5 C36.5 46.5 34 43.8 34 40.8 H39.5 C39.5 41.8 40.3 42.5 41.6 42.5 C43.5 42.5 44.8 41.3 44.8 38.5 V18 Z" fill="url(#whiteGrad)"/>
  </g>
</svg>

